{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(fix)"],
  "timezone": "Europe/Zurich",
  "schedule": ["* 0-5 * * 6"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "immediate",
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Bundle all non-security updates into a single weekly PR; release-plz owns application versions",
      "matchManagers": ["cargo", "github-actions", "dockerfile"],
      "groupName": "dependencies",
      "automerge": true
    },
    {
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Major upgrades hold the weekly PR for manual review",
      "matchManagers": ["cargo", "github-actions", "dockerfile"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pre-1.0 Cargo minor upgrades hold the weekly PR for manual review",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Track refreshed images on the existing release stream",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Docker tag upgrades hold the weekly PR for manual review; only digests auto-merge",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "automerge": false
    }
  ]
}
