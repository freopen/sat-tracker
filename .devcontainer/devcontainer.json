{
  "name": "sat-tracker",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "runArgs": ["--tmpfs=/tmp:rw,exec,nosuid,nodev,mode=1777"],
  "remoteUser": "vscode",
  "overrideCommand": false,
  "postCreateCommand": "prek install --force",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ]
    }
  }
}
